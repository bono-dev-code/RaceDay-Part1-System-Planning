@model List<ResultModel>
@{
    ViewData["Title"] = "Event results";
    var eventId = (int)ViewBag.EventId;
}
    <section class="container section-space">
        <div class="section-heading">
            <div>
                <span class="eyebrow text-orange">
                    Official standings
                </span>
                <h1>
                    Event results
                </h1>
            </div>
            <a asp-action="Enrolments" asp-route-eventId="@eventId" class="btn btn-outline-dark">
                Participants
            </a>
        </div>
        @if(Model.Count == 0){
            <div class="empty-state">
                <div class="empty-icon">
                    ⏱️
                </div>
                <h2>
                    No results published
                </h2>
                <p>
                    Confirm participant enrolments, then publish results after the event.
                </p>
            </div>
        }
    else{
        <div class="table-card">
            <div class="table-responsive">
                <table class="table align-middle">
                    <thead>
                        <tr>
                            <th>
                                Position
                            </th>
                            <th>
                                Participant
                            </th>
                            <th>
                                Category
                            </th>
                            <th>
                                Finish time
                            </th>
                            <th>
                                Published
                            </th>
                            <th>
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach(var item in Model.OrderBy(x => x.FinishingPosition)){
                            <tr>
                                <td>
                                    <strong>
                                        #@item.FinishingPosition
                                    </strong>
                                </td>
                                <td>
                                    @item.Participant?.FirstName @item.Participant?.LastName
                                </td>
                                <td>
                                    @item.Category
                                </td>
                                <td>
                                    @item.FinishTime.ToString(@"hh\:mm\:ss")
                                </td>
                                <td>
                                    @item.PublishedAt.ToString("dd MMM yyyy")
                                </td>
                                <td class="text-end">
                                    <div class="d-flex justify-content-end gap-2">
                                        <a asp-action="EditResult"
                                           asp-route-id="@item.ResultID"
                                           asp-route-eventId="@eventId"
                                           class="btn btn-sm btn-outline-dark">
                                            Edit
                                        </a>
                                        <form asp-action="DeleteResult" method="post" data-confirm="Delete this published result?">
                                            <input type="hidden" name="id" value="@item.ResultID"/>
                                            <input type="hidden" name="eventId" value="@eventId"/>
                                            <button class="btn btn-sm btn-outline-danger">
                                                Delete
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</section>
