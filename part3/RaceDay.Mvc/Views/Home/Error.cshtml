@{
    ViewData["Title"] = "Something went wrong";
}
<section class="container section-space">
    <div class="empty-state">
        <div class="empty-icon">
            ⚠️
        </div>
        <h1>
            We hit an unexpected hurdle
        </h1>
        <p>
            Please return to the event list and try again.
        </p>
        <a asp-action="Index" class="btn btn-race">
            Back to events
        </a>
    </div>
</section>
