@model ProfileFormModel
@{
    ViewData["Title"] = "Edit profile";
}
<section class="container section-space narrow-page">
    <span class="eyebrow text-orange">
        Account settings
    </span>
    <h1>
        Edit your profile
    </h1>
    <form method="post" enctype="multipart/form-data" class="form-card mt-4">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3">
        </div>
        <div class="row g-3">
            <div class="col-md-6">
                <label asp-for="FirstName" class="form-label">
                </label>
                <input asp-for="FirstName" class="form-control"/>
            </div>
            <div class="col-md-6">
                <label asp-for="LastName" class="form-label">
                </label>
                <input asp-for="LastName" class="form-control"/>
            </div>
            <div class="col-md-6">
                <label asp-for="PhoneNumber" class="form-label">
                    Phone number
                </label>
                <input asp-for="PhoneNumber" class="form-control"/>
            </div>
            <div class="col-md-6">
                <label asp-for="DateOfBirth" class="form-label">
                    Date of birth
                </label>
                <input asp-for="DateOfBirth" class="form-control"/>
            </div>
            <div class="col-12">
                <label asp-for="ProfilePicture" class="form-label">
                    Profile picture
                </label>
                <input asp-for="ProfilePicture" class="form-control" accept=".jpg,.jpeg,.png,.webp"/>
                <div class="form-text">
                    JPG, PNG or WebP, maximum 5 MB. Stored securely in Azure Blob Storage.
                </div>
                <span asp-validation-for="ProfilePicture" class="text-danger">
                </span>
            </div>
        </div>
        <div class="d-flex gap-2 mt-4">
            <button class="btn btn-race">
                Save profile
            </button>
            <a asp-action="Index" class="btn btn-outline-dark">
                Cancel
            </a>
        </div>
    </form>
</section>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
