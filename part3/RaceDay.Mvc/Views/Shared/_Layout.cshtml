@{
    var role = Context.Session.GetString("Role");
    var firstName = Context.Session.GetString("FirstName");
    var signedIn = Context.Session.GetInt32("UserID").HasValue;
}
<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title>
            @ViewData["Title"] - RaceDay
        </title>
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@600;700;800&family=Inter:wght@400;500;600;700&display=swap"
              rel="stylesheet">
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
        <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    </head>
    <body>
        <nav class="navbar navbar-expand-lg navbar-dark race-nav sticky-top">
            <div class="container">
                <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                    <span class="brand-mark">
                        R
                    </span>
                    RaceDay
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav">
                    <span class="navbar-toggler-icon">
                    </span>
                </button>
                <div class="collapse navbar-collapse" id="mainNav">
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index">
                                Find events
                            </a>
                        </li>
                        @if (role == "Organiser")
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Organiser" asp-action="Dashboard">
                                    Dashboard
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Organiser" asp-action="Events">
                                    My events
                                </a>
                            </li>
                        }
                        @if (role == "Participant")
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Participant" asp-action="MyEvents">
                                    My events
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Participant" asp-action="MyResults">
                                    My results
                                </a>
                            </li>
                        }
                    </ul>
                    <div class="d-flex align-items-center gap-2">
                        @if (signedIn)
                        {
                            <a class="nav-user" asp-controller="Profile" asp-action="Index">
                                Hi, @firstName
                                <span class="role-pill">
                                    @role
                                </span>
                            </a>
                            <form asp-controller="Account" asp-action="Logout" method="post">
                                <button class="btn btn-outline-light btn-sm">
                                    Log out
                                </button>
                            </form>
                        }
                    else
                    {
                        <a class="btn btn-link text-white text-decoration-none" asp-controller="Account" asp-action="Login">
                            Log in
                        </a>
                        <a class="btn btn-race btn-sm" asp-controller="Account" asp-action="Register">
                            Join RaceDay
                        </a>
                    }
                </div>
            </div>
        </div>
    </nav>
    <main>
        <partial name="_Alerts" />
        @RenderBody()
    </main>
    <footer class="race-footer">
        <div class="container d-flex flex-wrap justify-content-between gap-2">
            <span>
                RaceDay event management
            </span>
            <span>
                Run. Walk. Cycle. Achieve.
            </span>
        </div>
    </footer>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js">
    </script>
    <script src="~/js/site.js" asp-append-version="true">
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
